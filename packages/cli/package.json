{
  "name": "@auto-guard/cli",
  "version": "0.3.0",
  "description": "Unified management CLI and installer for auto-guard.",
  "license": "MIT",
  "type": "module",
  "main": "src/auto-guard.ts",
  "exports": {
    ".": "./src/auto-guard.ts",
    "./shell": "./src/shell.ts",
    "./status-store": "./src/status-store.ts",
    "./installer": "./src/installer/install.ts",
    "./installer/detect": "./src/installer/detect.ts",
    "./installer/integration": "./src/installer/integration.ts",
    "./installer/plan": "./src/installer/plan.ts",
    "./installer/rule-update": "./src/installer/rule-update.ts",
    "./installer/profiles": "./src/installer/profiles.ts",
    "./installer/banner": "./src/installer/banner.ts"
  },
  "bin": {
    "auto-guard": "src/auto-guard.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@auto-guard/core": "workspace:*",
    "@auto-guard/host-claude": "workspace:*",
    "@auto-guard/host-opencode": "workspace:*",
    "@auto-guard/host-pi": "workspace:*",
    "@auto-guard/host-qoder": "workspace:*",
    "@auto-guard/host-zcode": "workspace:*",
    "auto-guard": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
