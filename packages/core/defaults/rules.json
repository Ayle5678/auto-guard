  "staticAllowGuards": [
    {
      "when": "git branch *",
      "flags": [
        "-d",
        "-D",
        "--delete"
      ],
      "reason": "Deleting a branch is destructive"
    },
    {
      "when": "git -C * branch *",
      "flags": [
        "-d",
        "-D",
        "--delete"
      ],
      "reason": "Deleting a branch in a specific directory is destructive"
    },
    {
      "when": "git tag *",
      "flags": [
        "-d",
        "--delete"
      ],
      "reason": "Deleting a tag is destructive"
    },
    {
      "when": "find *",
      "flags": [
        "-delete",
        "-exec",
        "-execdir"
      ],
      "reason": "find can delete or execute files"
    },
    {
      "when": "fd *",
      "flags": [
        "-x",
        "-X",
        "--exec",
        "--exec-batch"
      ],
      "reason": "fd can execute commands"
    },
    {
      "when": "sort *",
      "flags": [
        "-o",
        "--output"
      ],
      "reason": "sort writing to a file is not read-only"
    },
    {
      "when": "shuf *",
      "flags": [
        "-o",
        "--output"
      ],
      "reason": "shuf writing to a file is not read-only"
    },
    {
      "when": "git stash *",
      "flags": [
        "drop",
        "clear"
      ],
      "reason": "Dropping or clearing stashes is destructive"
    },
    {
      "when": "git reset *",
      "flags": [
        "--hard"
      ],
      "reason": "Hard reset discards working tree changes"
    },
    {
      "when": "git clean *",
      "flags": [
        "-f",
        "-fd",
        "-ff",
        "--force"
      ],
      "reason": "Deleting untracked files is destructive"
    }
  ],
